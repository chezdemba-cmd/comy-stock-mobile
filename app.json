{
  "expo": {
    "name": "Comy_stock",
    "slug": "comy-stock",
    "scheme": "comystock",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#15171a",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.comystock.app"
    },
    "android": {
      "package": "com.comystock.app",
      "adaptiveIcon": {
        "backgroundColor": "#15171a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/mark.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#15171a"
        }
      ],
      "expo-font",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Comy_stock a besoin de la caméra pour scanner les codes-barres de vos produits.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Comy_stock a besoin d'accéder à vos photos pour illustrer vos produits.",
          "cameraPermission": "Comy_stock a besoin de la caméra pour prendre une photo de vos produits.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "@sentry/react-native/expo"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f6477187-2f21-49bf-b0aa-c9d44880d455"
      }
    },
    "owner": "chezdembas"
  }
}
