# Copiez ce fichier vers .env et renseignez vos identifiants Supabase du projet.
# Ces variables sont exposées au bundle client (préfixe EXPO_PUBLIC_) : ne jamais y mettre
# la clé service_role, uniquement l'URL publique et la clé anonyme (anon/public).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optionnel : DSN Sentry (projet Sentry > Settings > Client Keys). Comme la clé anon
# Supabase ci-dessus, ce n'est pas un secret à protéger (il est fait pour être embarqué
# dans le bundle client) — sans valeur, l'app démarre normalement mais les erreurs ne
# remontent nulle part.
EXPO_PUBLIC_SENTRY_DSN=
