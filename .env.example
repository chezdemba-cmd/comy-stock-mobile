# Copiez ce fichier vers .env et renseignez vos identifiants Supabase du projet.
# Ces variables sont exposées au bundle client (préfixe EXPO_PUBLIC_) : ne jamais y mettre
# la clé service_role, uniquement l'URL publique et la clé anonyme (anon/public).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
